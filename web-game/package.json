{
  "name": "stonewake-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:stations": "node tests/stations.mjs",
    "test:creatures": "node tests/creatures.mjs",
    "test:exploration": "node tests/exploration.mjs",
    "test:advanced": "node tests/advanced.mjs",
    "test:visuals": "node tests/visuals.mjs",
    "test:visual-improvement": "node tests/visual-improvement.mjs",
    "test:swimming": "node tests/swimming.mjs",
    "test:swimming-fix": "node tests/swimming-fix.mjs",
    "test:crafting-overhaul": "node tests/crafting-overhaul.mjs",
    "test:recipe-book": "node tests/recipe-book.mjs",
    "test:final": "node tests/final.mjs",
    "test:performance": "node tests/performance.mjs",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@types/three": "^0.181.0",
    "playwright": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
